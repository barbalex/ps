# Development backend stack (backend-dev/docker-compose.yml).
# Copy to backend-dev/.env — the copy is local-only, never committed:
#   cp backend-dev/.env.example backend-dev/.env
# All values here are local-only; nothing reaches production.

DB_SCHEMA=public
POSTGRES_DB=ps
POSTGRES_USER=postgres
# any local-only password (keep in sync with DATABASE_URL below)
POSTGRES_PASSWORD=dev-change-me
# sslmode=disable due to: https://github.com/electric-sql/pglite/blob/main/packages/pglite-sync/example/docker-compose.yaml
DATABASE_URL=postgresql://postgres:dev-change-me@db:5432/ps?sslmode=disable

# electric sync service
# TODO: set ELECTRIC_SECRET for live version
ELECTRIC_INSECURE=true
ELECTRIC_FEATURE_FLAGS=allow_subqueries,tagged_subqueries

# PostgREST
DB_ANON_ROLE=web_anon
# signs the JWTs the auth server issues and PostgREST/electric verify
PGRST_JWT_SECRET=dev-change-me
PGRST_SERVER_PORT=3002

# auth server (better-auth)
# any local-only secret
BETTER_AUTH_SECRET=dev-change-me
BETTER_AUTH_URL=http://localhost:3003
CLIENT_ORIGIN=http://localhost:5176
# add LAN origins for mobile testing (`npm run dev-host`); update if the DHCP lease changes
CORS_ORIGINS=http://localhost:5176

# the dev auth server auto-provisions this preview login with the own
# role on every project (email verified) — see CLAUDE.md "Development Backend"
#PREVIEW_TEST_EMAIL=test@test.ch
#PREVIEW_TEST_PASSWORD=test-test

# not read by the dev auth server — kept for parity with production
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#MAILGUN_API_KEY=
#MAILGUN_BASE_URL=https://api.eu.mailgun.net
#MAILGUN_DOMAIN=
#MAILGUN_FROM=
