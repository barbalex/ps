  },
  "overrides": {
    "tabster": "8.8.0",
    "@typescript-eslint/eslint-plugin": {
      "typescript": "6.0.3"
    },
    "@typescript-eslint/parser": {
      "typescript": "6.0.3"
    }
  },
  "devRemarks": {
    "nothing": "now",
    "tabster": "errors were caused. tabster@8.7.0 bundled its own keyborg@2.6.0 which conflicted with the top-level keyborg@2.14.0 required by @fluentui/react-components — keyborg 2.14 removed getNavigating, so forcing tabster@8.8.0 (which depends on keyborg@^2.14.0) eliminates the nested copy and makes both packages use the same API.",
    "typescript-eslint": "typescript@7 (native) ships no JS API, which @typescript-eslint still requires (its peer range caps at <6.1.0), so eslint cannot run on v7 yet. The overrides pin the peer to typescript@6.0.3, and the postinstall script (scripts/patch-eslint-typescript.mjs) copies the aliased typescript-v6 devDependency into @typescript-eslint/parser and @typescript-eslint/eslint-plugin, because npm cannot nest a peer-satisfying typescript copy under root-level packages. Root typescript stays on v7 for tsc. Drop overrides + typescript-v6 + postinstall once typescript-eslint supports v7."
  }
}
